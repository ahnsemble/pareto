{
  "redirects": [
    { "source": "/", "destination": "/en", "type": 302 },
    { "source": "/optimize", "destination": "/en/optimize", "type": 302 },
    { "source": "/optimize/", "destination": "/en/optimize", "type": 302 },
    { "source": "/twodeck", "destination": "/en/twodeck", "type": 302 },
    { "source": "/twodeck/", "destination": "/en/twodeck", "type": 302 },
    { "source": "/community", "destination": "/en/community", "type": 302 },
    { "source": "/community/", "destination": "/en/community", "type": 302 },
